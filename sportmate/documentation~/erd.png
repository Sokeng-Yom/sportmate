auth.users (Supabase-managed)
      │
      ▼
   profiles ──┬── user_sports
              ├── matches (created_by)
              ├── match_players (user_id)
              ├── waiting_list (user_id)
              ├── match_leaves (user_id)
              ├── venues (owner_id)
              ├── conversation_members (user_id)
              ├── posts (author_id)
              └── notifications (user_id)

matches ──┬── match_players
          ├── waiting_list
          ├── match_leaves
          └── bookings

venues ──── courts ──── bookings

conversations ──┬── conversation_members
                └── messages

posts ──┬── comments
        └── post_likes